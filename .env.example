# Copy this file to .env and fill in the values you need:
#   cp .env.example .env
# .env is ignored by git. Never commit a real key.
# Use plain KEY=value lines, without quotes.

# Anthropic API key, used by the model pipeline (from SAN-11 on).
# Not needed to run the app or the tests: the tests use a fake model client.
ANTHROPIC_API_KEY=

# Where reports are stored. Default: data/mission_control.db in the repo.
# MISSION_CONTROL_DB_URL=sqlite:////absolute/path/to/mission_control.db
